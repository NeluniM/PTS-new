	    <version>2.13.4.2</version>
	</dependency>
		
	<!-- jstl -->
	
	
	<dependency>
		<groupId>com.google.zxing</groupId>
		<artifactId>javase</artifactId>
		<version>2.2</version>
	</dependency>
