		<class>com.it.ceb.pts.domain.MeterReading</class>
		<class>com.it.ceb.pts.domain.MeterReadingEnergySummary</class>
		<class>com.it.ceb.pts.domain.MeterReadingErrLog</class>
		<class>com.it.ceb.pts.domain.MeterReadingLog</class>
		<class>com.it.ceb.pts.domain.PrimarySubstation</class>
		<class>com.it.ceb.pts.domain.Province</class>
		<class>com.it.ceb.pts.domain.Transformer</class>
		<class>com.it.ceb.pts.domain.Sauserm</class>


